# OMAHCODE Configuration
APP_NAME=OMAHCODE
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/omahcode

# Database Driver: sqlite or mysql
DB_CONNECTION=sqlite

# SQLite Path (relative to project root or absolute)
DB_SQLITE_PATH=database/omahcode.sqlite

# MySQL Configuration (if using MySQL / Laragon)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=omahcode
DB_USERNAME=root
DB_PASSWORD=

# Admin Security
SESSION_LIFETIME=7200

